# Configuração do backend (Django) - copie para `.env` e ajuste os valores.
# NUNCA comite o arquivo .env.

# Obrigatório em produção: gere com
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me

# Use False em produção.
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Senha inicial aplicada a gestores criados sem o campo `password`.
# Deixe vazio para exigir que a senha seja informada em cada cadastro.
DEFAULT_GESTOR_PASSWORD=

# Tempo de vida dos tokens JWT.
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Opcional: banco PostgreSQL (se ausente, usa SQLite local).
# DATABASE_URL=postgres://usuario:senha@localhost:5432/patritech

# Origens confiáveis para requisições CSRF (admin do Django em produção).
# Ex.: https://patri-tech-web.vercel.app
# CSRF_TRUSTED_ORIGINS=

# Em produção (DJANGO_DEBUG=False) o HTTPS é forçado por padrão.
# Use False apenas se o proxy não encaminhar X-Forwarded-Proto.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=3600

# Opcional: armazenamento de arquivos em S3 (as quatro variáveis juntas).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
